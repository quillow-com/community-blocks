{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.3.0/schemas/config.json",
  "release-type": "simple",
  "draft": true,
  "force-tag-creation": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": true,
  "sequential-calls": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "chore",
      "section": "Maintenance"
    }
  ],
  "packages": {
    "blocks/before-after-slider": {
      "component": "before-after-slider",
      "package-name": "before-after-slider",
      "initial-version": "1.0.0",
      "extra-files": [
        {
          "type": "json",
          "path": "metadata.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "blocks/crypto-coinpaprika": {
      "component": "crypto-coinpaprika",
      "package-name": "crypto-coinpaprika",
      "initial-version": "1.0.0",
      "extra-files": [
        {
          "type": "json",
          "path": "metadata.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "blocks/faq-accordion": {
      "component": "faq-accordion",
      "package-name": "faq-accordion",
      "initial-version": "1.0.0",
      "extra-files": [
        {
          "type": "json",
          "path": "metadata.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "blocks/social-counter": {
      "component": "social-counter",
      "package-name": "social-counter",
      "initial-version": "1.0.0",
      "extra-files": [
        {
          "type": "json",
          "path": "metadata.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
