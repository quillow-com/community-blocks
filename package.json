{
  "name": "@quillow/custom-blocks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quillow-com/custom-blocks.git"
  },
  "scripts": {
    "new": "node scripts/new.mjs",
    "build": "node scripts/build.mjs",
    "check:blocks": "node scripts/build.mjs --check",
    "sync:releases": "node scripts/sync-releases.mjs",
    "check:releases": "node scripts/sync-releases.mjs --check",
    "check:versions": "node scripts/check-versions.mjs",
    "sync:runtime": "node scripts/sync-runtime.mjs",
    "check:runtime": "node scripts/sync-runtime.mjs --check",
    "publish:catalog": "node scripts/publish.mjs",
    "test": "node --test tests/*.test.mjs workers/catalog/test/*.test.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run check:runtime && npm run check:releases && npm test && npm run check:blocks"
  },
  "devDependencies": {
    "@quillow/custom-block-sdk": "0.6.0",
    "@quillow/skills": "https://codeload.github.com/quillow-com/skills/tar.gz/8df2eb7c0b49e286ede92024fb093c07f53b3d1c",
    "image-size": "2.1.0",
    "prettier": "3.9.10",
    "release-please": "17.3.0"
  },
  "overrides": {
    "@google-automations/git-file-utils": {
      "minimatch": "11.0.1"
    }
  }
}
